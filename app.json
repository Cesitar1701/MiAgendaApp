{
  "expo": {
    "name": "MiAgendaApp",
    "slug": "MiAgendaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E6F4FE"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MiAgenda necesita acceso a tus fotos para adjuntar imágenes a tus recordatorios.",
          "cameraPermission": "MiAgenda necesita acceso a la cámara para tomar fotos en tus recordatorios."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MiAgenda necesita acceder a tu ubicacion para asociar el lugar a tus recordatorios."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "MiAgenda necesita acceso a tus contactos para asociarlos a tus recordatorios."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "MiAgenda necesita acceso a tu calendario para sincronizar tus recordatorios."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MiAgendaApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}